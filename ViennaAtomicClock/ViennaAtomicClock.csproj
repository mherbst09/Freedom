<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Freedom</AssemblyName>
    <RootNamespace>ViennaAtomicClock</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Freedom</Authors>
    <Product>Freedom</Product>
    <Description>Präzise NTP-synchronisierte Uhr für die Zeitzone Wien.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <InternalsVisibleTo Include="Freedom.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
  </ItemGroup>
  <ItemGroup>
    <!-- GLB viewer: HTML, CSS, JS and the local Three.js copy are embedded, so the single-file EXE works offline. -->
    <EmbeddedResource Include="GlbViewer\Web\**\*" LogicalName="GlbViewer/Web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
