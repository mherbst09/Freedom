<Window x:Class="ViennaAtomicClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ViennaAtomicClock"
        xmlns:tutor="clr-namespace:ViennaAtomicClock.Tutor"
        Title="Freedom" Width="1120" Height="720"
        Icon="app.ico"
        MinWidth="420" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
    <!-- A normal (not see-through) window: Windows 11 draws the rounded corners and the shadow itself,
         which keeps every frame cheap and every text sharp with ClearType. -->
    <Border x:Name="WindowShell" RenderOptions.ClearTypeHint="Enabled" Background="{DynamicResource WindowBackground}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Theme backdrops behind the (partly translucent) cards. -->
            <local:HackerRain x:Name="HackerRainLayer" Grid.RowSpan="2" Visibility="Collapsed"/>
            <local:AnimeBackdrop x:Name="AnimeLayer" Grid.RowSpan="2" Visibility="Collapsed"/>
            <local:TetrisBackdrop x:Name="TetrisLayer" Grid.RowSpan="2" Visibility="Collapsed"/>
            <local:AmericaBackdrop x:Name="AmericaLayer" Grid.RowSpan="2" Visibility="Collapsed"/>
            <local:MinecraftBackdrop x:Name="MinecraftLayer" Grid.RowSpan="2" Visibility="Collapsed"/>
            <local:EagleBackdrop x:Name="EagleLayer" Grid.RowSpan="2" Visibility="Collapsed"/>
            <local:MysticBackdrop x:Name="MysticLayer" Grid.RowSpan="2" Visibility="Collapsed"/>

            <!-- Custom title bar -->
            <Grid x:Name="TitleBarGrid" Grid.Row="0" Margin="24,0,16,0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AppSwitcherButton" Width="42" Height="42" Background="{DynamicResource AccentBrush}" BorderThickness="0" Foreground="{DynamicResource AccentForeground}" FontSize="22" Content="⊞" Cursor="Hand" ToolTip="{DynamicResource L.tip.apps}" Click="AppSwitcherButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SwitchBg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CardRadius}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"><ContentPresenter.Resources><Style TargetType="TextBlock"/></ContentPresenter.Resources></ContentPresenter>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchBg" Property="Opacity" Value="0.82"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Popup x:Name="AppSwitcherPopup" PlacementTarget="{Binding ElementName=AppSwitcherButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="0" VerticalOffset="8" Opened="Popup_Opened">
                        <Grid Margin="0,0,14,14" TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled">
                        <Border Background="{DynamicResource PopupBrush}" CornerRadius="{DynamicResource CardRadius}">
                            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.32"/></Border.Effect>
                        </Border>
                        <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="12">
                            <StackPanel Width="310">
                                <TextBlock Text="{DynamicResource L.apps}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="6,2,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="10"/><RowDefinition/><RowDefinition Height="10"/><RowDefinition/></Grid.RowDefinitions>
                                    <Button x:Name="ClockTileButton" Grid.Row="0" Grid.Column="0" Background="{DynamicResource SurfaceAlt}" BorderThickness="0" Cursor="Hand" Click="ClockTileButton_Click">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CardRadius}" Padding="14"><StackPanel><TextBlock Text="◷" FontSize="25" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Freedom" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="{DynamicResource L.tile.clock.hint}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/></StackPanel></Border></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button x:Name="CaffeineTileButton" Grid.Row="0" Grid.Column="2" Background="{DynamicResource SurfaceAlt}" BorderThickness="0" Cursor="Hand" Click="CaffeineTileButton_Click">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CardRadius}" Padding="14"><StackPanel><TextBlock Text="☕" FontSize="25" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{DynamicResource L.tile.coffee}" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="{DynamicResource L.tile.coffee.hint}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/></StackPanel></Border></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button x:Name="TodoTileButton" Grid.Row="2" Grid.Column="0" Background="{DynamicResource SurfaceAlt}" BorderThickness="0" Cursor="Hand" Click="TodoTileButton_Click">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CardRadius}" Padding="14"><StackPanel><TextBlock Text="☑" FontSize="25" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{DynamicResource L.tile.todo}" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="{DynamicResource L.tile.todo.hint}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/></StackPanel></Border></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button x:Name="NotesTileButton" Grid.Row="2" Grid.Column="2" Background="{DynamicResource SurfaceAlt}" BorderThickness="0" Cursor="Hand" Click="NotesTileButton_Click">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CardRadius}" Padding="14"><StackPanel><TextBlock Text="✎" FontSize="25" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{DynamicResource L.tile.notes}" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="{DynamicResource L.tile.notes.hint}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/></StackPanel></Border></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button x:Name="TutorTileButton" Grid.Row="4" Grid.Column="0" Background="{DynamicResource SurfaceAlt}" BorderThickness="0" Cursor="Hand" Click="TutorTileButton_Click">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CardRadius}" Padding="14"><StackPanel><TextBlock Text="◆" FontSize="25" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="AI" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="{DynamicResource L.tile.ai.hint}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/></StackPanel></Border></ControlTemplate></Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </Popup>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppTitleText" Text="FREEDOM" FontFamily="{DynamicResource StencilFont}" FontSize="17"/>
                        <TextBlock x:Name="AppSubtitleText" Text="Atomzeit · Stundenplan · Wien" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="HeaderStatusBadge" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource GreenSoft}" Padding="11,7" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HeaderStatusDot" Width="7" Height="7" Fill="{DynamicResource GreenBrush}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="HeaderStatusText" Text="Synchronisiere …" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="⚙" FontSize="19" ToolTip="{DynamicResource L.tip.settings}" Click="SettingsButton_Click"/>
                    <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="⛶" FontSize="17" ToolTip="{DynamicResource L.tip.fullscreen}" Click="FocusButton_Click"/>
                    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-340" VerticalOffset="8" Opened="Popup_Opened">
                        <Grid Margin="0,0,14,14" TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled">
                            <Border Background="{DynamicResource PopupBrush}" CornerRadius="{DynamicResource CardRadius}">
                                <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.34"/></Border.Effect>
                            </Border>
                            <Border x:Name="SettingsPanel" Width="400" Height="640" MinWidth="330" MinHeight="380" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource CardRadius}" Padding="18,14,10,14" SizeChanged="SettingsPanel_SizeChanged">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid Margin="0,0,6,10">
                                        <TextBlock Text="{DynamicResource L.settings}" FontFamily="{DynamicResource StencilFont}" FontSize="18" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="SettingsExpandButton" Style="{StaticResource IconButton}" Width="34" Height="34" Content="⤢" ToolTip="{DynamicResource L.settings.expand}" Click="SettingsExpand_Click"/>
                                            <Button Style="{StaticResource IconButton}" Width="34" Height="34" Content="×" FontSize="20" ToolTip="{DynamicResource L.close}" Click="SettingsClose_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{DynamicResource L.settings.language}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,6"/>
                                            <WrapPanel x:Name="LanguageList"/>
                                            <TextBlock Text="{DynamicResource L.settings.appearance}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,14,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <Button x:Name="LightModeButton" Style="{StaticResource ChipButton}" Margin="0" Height="38" Click="LightModeButton_Click">
                                                    <TextBlock><Run Text="☀  "/><Run Text="{DynamicResource L.mode.light}"/></TextBlock>
                                                </Button>
                                                <Button x:Name="DarkModeButton" Grid.Column="2" Style="{StaticResource ChipButton}" Margin="0" Height="38" Click="DarkModeButton_Click">
                                                    <TextBlock><Run Text="☾  "/><Run Text="{DynamicResource L.mode.dark}"/></TextBlock>
                                                </Button>
                                                <Button x:Name="ColorModeButton" Grid.Column="4" Style="{StaticResource ChipButton}" Margin="0" Height="38" Click="ColorModeButton_Click">
                                                    <TextBlock><Run Text="◐  "/><Run Text="{DynamicResource L.mode.color}"/></TextBlock>
                                                </Button>
                                            </Grid>
                                            <Border x:Name="ColorPickerHost" Margin="0,10,0,0" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}" CornerRadius="{DynamicResource CardRadius}" Visibility="Collapsed">
                                                <local:ColorPicker x:Name="ThemeColorPicker"/>
                                            </Border>
                                            <TextBlock Text="{DynamicResource L.settings.animations}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,16,0,6"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource L.anim.fireworks}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,8,0"/>
                                                <Button x:Name="FireworksToggle" Grid.Column="1" Style="{StaticResource ChipButton}" Height="34" Padding="14,0" Click="FireworksToggle_Click"/>
                                                <Button Grid.Column="2" Style="{StaticResource ChipButton}" Height="34" Margin="0" Padding="14,0" Content="{DynamicResource L.anim.test}" Click="FireworksButton_Click"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource L.anim.gloom}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,8,0"/>
                                                <Button x:Name="GloomToggle" Grid.Column="1" Style="{StaticResource ChipButton}" Height="34" Padding="14,0" Click="GloomToggle_Click"/>
                                                <Button Grid.Column="2" Style="{StaticResource ChipButton}" Height="34" Margin="0" Padding="14,0" Content="{DynamicResource L.anim.test}" Click="GloomTest_Click"/>
                                            </Grid>
                                            <TextBlock Text="{DynamicResource L.settings.theme}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,16,0,6"/>
                                            <UniformGrid x:Name="ThemeList" Columns="2"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <Thumb x:Name="SettingsResizeGrip" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" Cursor="SizeNWSE"
                                   DragDelta="SettingsResize_DragDelta" ToolTip="{DynamicResource L.settings.resize}">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Path Data="M 18,6 L 6,18 M 18,11 L 11,18 M 18,16 L 16,18" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Popup>
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="⌖" ToolTip="{DynamicResource L.tip.pin}" Click="PinButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="—" ToolTip="{DynamicResource L.tip.minimize}" Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="×" FontSize="24" ToolTip="{DynamicResource L.close}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="ClockPage" Grid.Row="1" Margin="24,4,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.05*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1.25*" MinWidth="380"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Main clock -->
                    <Border x:Name="ClockCard" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="36,24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource L.clock.city}" FontFamily="{DynamicResource StencilFont}" FontSize="14" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Border CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource AccentSoft}" Padding="8,4" Margin="10,0,0,0">
                                        <TextBlock x:Name="UtcOffsetBadge" Text="UTC+02:00" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="DstText" Text="Sommerzeit" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Viewbox lets the time grow and shrink with the window (small window up to beamer). -->
                            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" Margin="0,10" TextOptions.TextFormattingMode="Ideal">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Grid>
                                        <!-- The glow is a blurred copy behind the time, so the time itself stays razor sharp. -->
                                        <TextBlock x:Name="MainTimeGlow" Typography.NumeralAlignment="Tabular" Text="{Binding Text, ElementName=MainTimeText}" FontFamily="{DynamicResource DisplayFont}" FontSize="76" FontWeight="SemiBold" Foreground="{Binding Foreground, ElementName=MainTimeText}" Visibility="Collapsed" IsHitTestVisible="False"/>
                                        <TextBlock x:Name="MainTimeText" Typography.NumeralAlignment="Tabular" Text="00:00:00" FontFamily="{DynamicResource DisplayFont}" FontSize="76" FontWeight="SemiBold"/>
                                    </Grid>
                                    <TextBlock x:Name="MicrosecondsText" Typography.NumeralAlignment="Tabular" Text=".000000" FontFamily="{DynamicResource DisplayFont}" FontSize="24" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" Opacity="0.7" VerticalAlignment="Bottom" Margin="8,0,0,13"/>
                                </StackPanel>
                                <TextBlock x:Name="DateText" Text="Donnerstag, 15. Oktober 2026" FontSize="18" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                            </Viewbox>

                            <Grid Grid.Row="2">
                                <Border Height="5" CornerRadius="3" Background="{DynamicResource TrackBrush}"/>
                                <Border Height="5" CornerRadius="3" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="SecondProgress" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Lesson countdown -->
                    <Border x:Name="LessonCard" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="28,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="LessonBadge" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource AccentSoft}" Padding="9,4">
                                        <TextBlock x:Name="LessonBadgeText" Text="1. STUNDE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <TextBlock x:Name="LessonRangeText" Text="07:45 – 08:35" FontFamily="{DynamicResource DisplayFont}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="LessonOfDayText" Text="" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="LessonLabelText" Text="Stunde endet in" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock x:Name="LessonNextText" Text="" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" TextOptions.TextFormattingMode="Ideal">
                                    <TextBlock x:Name="LessonCountdownGlow" Typography.NumeralAlignment="Tabular" Text="{Binding Text, ElementName=LessonCountdownText}" FontFamily="{DynamicResource DisplayFont}" FontSize="{Binding FontSize, ElementName=LessonCountdownText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="LessonCountdownText" Typography.NumeralAlignment="Tabular" Text="00:00" FontFamily="{DynamicResource DisplayFont}" FontSize="60" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Border Height="8" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource TrackBrush}"/>
                                <Border x:Name="LessonProgressFill" Height="8" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="LessonProgress" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right panel: today's timetable -->
                <Border x:Name="ScheduleCard" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="20,22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.schedule.title}" FontFamily="{DynamicResource StencilFont}" FontSize="24"/>
                                <TextBlock x:Name="ScheduleSubtitleText" Text="11 Stunden à 50 Minuten" FontSize="13.5" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="GroupButton" Style="{StaticResource ChipButton}" Height="26" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Content="Gruppe: beide" ToolTip="{DynamicResource L.tip.group}" Click="GroupButton_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel x:Name="ScheduleList" TextOptions.TextFormattingMode="Ideal"/>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="{DynamicResource CardRadius}" Padding="14,10" Margin="0,12,0,0"
                                ToolTip="{DynamicResource L.tip.sync}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="SyncStatusText" Text="{DynamicResource L.sync.checking}" FontSize="12" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{DynamicResource L.sync.last}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="LastSyncText" Text="—" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,4,0,0">
                                    <TextBlock x:Name="SourceText" Text="Windows-Systemzeit" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="OffsetText" Text="± 0,000 ms" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="LatencyText" Text="— ms" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Button x:Name="SyncButton" Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource ActionButton}" Content="{DynamicResource L.sync.button}" Padding="8,0" Click="SyncButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
            <!-- Caffeine tracker -->
            <ScrollViewer x:Name="CaffeineScroll" Grid.Row="1" Margin="24,4,24,24" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid x:Name="CaffeinePage">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" MinWidth="260"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.45*" MinWidth="360"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="0.85*" MinWidth="230"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <!-- Daily summary -->
                <Border x:Name="CaffeineSummaryCard" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.coffee.today}" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TrackerDateText" Text="Donnerstag, 15. Oktober" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Width="190" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12">
                            <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="13"/>
                            <Path x:Name="CaffeineProgressArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="13" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="CaffeineTotalText" Text="0" FontFamily="{DynamicResource DisplayFont}" FontSize="46" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource L.coffee.mgToday}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                <Border x:Name="LimitStatusBadge" Background="{DynamicResource GreenSoft}" CornerRadius="{DynamicResource CardRadius}" Padding="9,4" Margin="0,9,0,0">
                                    <TextBlock x:Name="LimitStatusText" Text="im Rahmen" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.coffee.active}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="ActiveCaffeineText" Text="0 mg" FontFamily="{DynamicResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource L.coffee.toLimit}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="RemainingCaffeineText" Text="400 mg" FontFamily="{DynamicResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3" Background="{DynamicResource SurfaceAlt}" CornerRadius="{DynamicResource CardRadius}" Padding="14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L.coffee.limit}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource L.coffee.limitHint}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBox x:Name="DailyLimitTextBox" Grid.Column="1" Style="{StaticResource InputTextBox}" Height="38" Text="400" TextAlignment="Center" LostFocus="DailyLimitTextBox_LostFocus" KeyDown="DailyLimitTextBox_KeyDown"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource L.coffee.efsa}"
                                           TextWrapping="Wrap" FontSize="9.5" LineHeight="14" Foreground="{DynamicResource TextMuted}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Product catalog -->
                <Border x:Name="CaffeineCatalogCard" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.coffee.add}" FontSize="21" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CatalogCountText" Text="Produkte aus Österreich" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource L.coffee.portion}" FontSize="10" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,12">
                            <TextBox x:Name="ProductSearchTextBox" Style="{StaticResource InputTextBox}" Padding="36,0,12,0" TextChanged="ProductSearchTextBox_TextChanged"/>
                            <TextBlock Text="⌕" FontSize="20" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,1" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchHintText" Text="{DynamicResource L.coffee.search}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AllCategoryButton" Style="{StaticResource ChipButton}" Content="{DynamicResource L.coffee.all}" Tag="Alle" Click="CategoryButton_Click" Background="{DynamicResource AccentSoft}" Foreground="{DynamicResource AccentBrush}"/>
                            <Button x:Name="EnergyCategoryButton" Style="{StaticResource ChipButton}" Content="{DynamicResource L.coffee.energy}" Tag="Energy" Click="CategoryButton_Click"/>
                            <Button x:Name="CoffeeCategoryButton" Style="{StaticResource ChipButton}" Content="{DynamicResource L.coffee.coffee}" Tag="Kaffee" Click="CategoryButton_Click"/>
                            <Button x:Name="MoreCategoryButton" Style="{StaticResource ChipButton}" Content="{DynamicResource L.coffee.more}" Tag="Mehr" Click="CategoryButton_Click"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-6,0">
                            <ItemsControl x:Name="ProductsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="{DynamicResource CardRadius}" Margin="0,0,6,8" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Image, Mode=OneWay}" Width="48" Height="48" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Brand, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ServingLabel, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Store, Mode=OneWay}" FontSize="9" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource RoundAddButton}" Content="+" DataContext="{Binding}" Click="AddProductButton_Click" ToolTip="{DynamicResource L.coffee.addNow}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="4" Style="{StaticResource SecondaryButton}" Height="40" Content="{DynamicResource L.coffee.custom}" Margin="0,10,0,0" Click="OpenCustomEntryButton_Click"/>
                    </Grid>
                </Border>

                <!-- Today's log -->
                <Border x:Name="CaffeineLogCard" Grid.Column="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.coffee.history}" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock x:Name="EntryCountText" Text="{DynamicResource L.coffee.noEntries}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,16,0,10">
                            <StackPanel x:Name="EmptyHistoryPanel" VerticalAlignment="Center">
                                <TextBlock Text="☕" FontSize="34" HorizontalAlignment="Center" Opacity="0.45"/>
                                <TextBlock Text="{DynamicResource L.coffee.emptyTitle}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="{DynamicResource L.coffee.emptyHint}" FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="8,3"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="HistoryItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Image Source="{Binding Image, Mode=OneWay}" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding ProductName, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="9.5" Foreground="{DynamicResource TextMuted}"><Run Text="{Binding TimeLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DetailLabel, Mode=OneWay}"/></TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding AmountLabel, Mode=OneWay}" FontFamily="{DynamicResource DisplayFont}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        <Button Content="{DynamicResource L.coffee.remove}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMuted}" FontSize="8.5" Padding="0" Cursor="Hand" DataContext="{Binding}" Click="DeleteEntryButton_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Border Grid.Row="2" Background="{DynamicResource AccentSoft}" CornerRadius="{DynamicResource CardRadius}" Padding="12">
                            <TextBlock x:Name="TrackerInsightText" Text="Deine Koffeinbilanz erscheint nach dem ersten Eintrag." TextWrapping="Wrap" FontSize="10" LineHeight="14" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>

            <!-- Todo list and notes, built in code like the other pages. -->
            <local:TodoPage x:Name="TodoView" Grid.Row="1" Margin="24,4,24,24" Visibility="Collapsed"/>
            <local:NotesPage x:Name="NotesView" Grid.Row="1" Margin="24,4,24,24" Visibility="Collapsed"/>
            <tutor:TutorPage x:Name="TutorView" Grid.Row="1" Margin="24,4,24,24" Visibility="Collapsed"/>

            <!-- Custom caffeine entry dialog -->
            <Grid x:Name="CustomEntryOverlay" Grid.RowSpan="2" Background="#A8000000" Visibility="Collapsed" Panel.ZIndex="100">
                <Border x:Name="CustomEntryCard" Width="430" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.custom.title}" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource L.custom.sub}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Content="×" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseCustomEntryButton_Click"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource L.custom.brand}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,6"/>
                        <TextBox x:Name="CustomBrandTextBox" Style="{StaticResource InputTextBox}"/>
                        <TextBlock Text="{DynamicResource L.custom.name}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,12,0,6"/>
                        <TextBox x:Name="CustomNameTextBox" Style="{StaticResource InputTextBox}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.custom.ml}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                <TextBox x:Name="CustomMlTextBox" Style="{StaticResource InputTextBox}" Text="250"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource L.custom.mg}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                <TextBox x:Name="CustomMgTextBox" Style="{StaticResource InputTextBox}" Text="80"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CustomEntryErrorText" Text="" FontSize="10" Foreground="{DynamicResource OrangeBrush}" Margin="0,9,0,0"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource L.cancel}" Click="CloseCustomEntryButton_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource ActionButton}" Content="{DynamicResource L.custom.save}" Click="SaveCustomEntryButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Old film projection: grain, dust, scratches, flicker and vignette over everything. -->
            <local:FilmOverlay x:Name="FilmGrain" Grid.RowSpan="2" Panel.ZIndex="200"/>
            <local:HackerScanlines x:Name="HackerScanLayer" Grid.RowSpan="2" Panel.ZIndex="200" Visibility="Collapsed"/>
            <local:AnimeOverlay x:Name="AnimeTop" Grid.RowSpan="2" Panel.ZIndex="200" Visibility="Collapsed"/>
            <local:MinecraftOverlay x:Name="MinecraftTop" Grid.RowSpan="2" Panel.ZIndex="200" Visibility="Collapsed"/>
            <local:MysticOverlay x:Name="MysticTop" Grid.RowSpan="2" Panel.ZIndex="200" Visibility="Collapsed"/>
        </Grid>
    </Border>
    </Grid>
</Window>
