<Window x:Class="ViennaAtomicClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ViennaAtomicClock"
        xmlns:tutor="clr-namespace:ViennaAtomicClock.Tutor"
        Title="Freedom" Width="1120" Height="720"
        Icon="app.ico"
        MinWidth="420" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="10" GlassFrameThickness="0" ResizeBorderThickness="7"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowShell" Margin="14" CornerRadius="10"
            Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Theme backdrops behind the (partly translucent) cards. -->
            <local:HackerRain x:Name="HackerRainLayer" Grid.RowSpan="2" Visibility="Collapsed"/>
            <local:AnimeBackdrop x:Name="AnimeLayer" Grid.RowSpan="2" Visibility="Collapsed"/>
            <local:TetrisBackdrop x:Name="TetrisLayer" Grid.RowSpan="2" Visibility="Collapsed"/>
            <local:AmericaBackdrop x:Name="AmericaLayer" Grid.RowSpan="2" Visibility="Collapsed"/>
            <local:MinecraftBackdrop x:Name="MinecraftLayer" Grid.RowSpan="2" Visibility="Collapsed"/>

            <!-- Custom title bar -->
            <Grid x:Name="TitleBarGrid" Grid.Row="0" Margin="24,0,16,0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AppSwitcherButton" Width="42" Height="42" Background="{DynamicResource AccentBrush}" BorderThickness="0" Foreground="{DynamicResource AccentForeground}" FontSize="22" Content="⊞" Cursor="Hand" ToolTip="Apps wechseln" Click="AppSwitcherButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SwitchBg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CardRadius}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"><ContentPresenter.Resources><Style TargetType="TextBlock"/></ContentPresenter.Resources></ContentPresenter>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchBg" Property="Opacity" Value="0.82"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Popup x:Name="AppSwitcherPopup" PlacementTarget="{Binding ElementName=AppSwitcherButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="0" VerticalOffset="8">
                        <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="12">
                            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.32"/></Border.Effect>
                            <StackPanel Width="310">
                                <TextBlock Text="APPS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="6,2,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="10"/><RowDefinition/><RowDefinition Height="10"/><RowDefinition/></Grid.RowDefinitions>
                                    <Button x:Name="ClockTileButton" Grid.Row="0" Grid.Column="0" Background="{DynamicResource SurfaceAlt}" BorderThickness="0" Cursor="Hand" Click="ClockTileButton_Click">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CardRadius}" Padding="14"><StackPanel><TextBlock Text="◷" FontSize="25" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Freedom" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Atomzeit · Stunden" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/></StackPanel></Border></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button x:Name="CaffeineTileButton" Grid.Row="0" Grid.Column="2" Background="{DynamicResource SurfaceAlt}" BorderThickness="0" Cursor="Hand" Click="CaffeineTileButton_Click">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CardRadius}" Padding="14"><StackPanel><TextBlock Text="☕" FontSize="25" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Koffein" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Tracker · mg" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/></StackPanel></Border></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button x:Name="TodoTileButton" Grid.Row="2" Grid.Column="0" Background="{DynamicResource SurfaceAlt}" BorderThickness="0" Cursor="Hand" Click="TodoTileButton_Click">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CardRadius}" Padding="14"><StackPanel><TextBlock Text="☑" FontSize="25" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Aufgaben" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Todo · Listen" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/></StackPanel></Border></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button x:Name="NotesTileButton" Grid.Row="2" Grid.Column="2" Background="{DynamicResource SurfaceAlt}" BorderThickness="0" Cursor="Hand" Click="NotesTileButton_Click">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CardRadius}" Padding="14"><StackPanel><TextBlock Text="✎" FontSize="25" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Notizen" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Schreiben · Suchen" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/></StackPanel></Border></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button x:Name="TutorTileButton" Grid.Row="4" Grid.Column="0" Background="{DynamicResource SurfaceAlt}" BorderThickness="0" Cursor="Hand" Click="TutorTileButton_Click">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CardRadius}" Padding="14"><StackPanel><TextBlock Text="◆" FontSize="25" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="AI" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Eagle 1.1 · lokal" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/></StackPanel></Border></ControlTemplate></Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppTitleText" Text="FREEDOM" FontFamily="{DynamicResource StencilFont}" FontSize="17"/>
                        <TextBlock x:Name="AppSubtitleText" Text="Atomzeit · Stundenplan · Wien" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="HeaderStatusBadge" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource GreenSoft}" Padding="11,7" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HeaderStatusDot" Width="7" Height="7" Fill="{DynamicResource GreenBrush}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="HeaderStatusText" Text="Synchronisiere …" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="⚙" FontSize="19" ToolTip="Einstellungen" Click="SettingsButton_Click"/>
                    <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="⛶" FontSize="17" ToolTip="Vollbild für Beamer (F11)" Click="FocusButton_Click"/>
                    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-300" VerticalOffset="8">
                        <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="16" Margin="0,0,12,12">
                            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.32"/></Border.Effect>
                            <ScrollViewer MaxHeight="680" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel Width="340" Margin="0,0,6,0">
                                <TextBlock Text="EINSTELLUNGEN" FontFamily="{DynamicResource StencilFont}" FontSize="17"/>
                                <TextBlock Text="Darstellung" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,14,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Button x:Name="LightModeButton" Style="{StaticResource ChipButton}" Margin="0" Height="38" Content="☀  Hell" Click="LightModeButton_Click"/>
                                    <Button x:Name="DarkModeButton" Grid.Column="2" Style="{StaticResource ChipButton}" Margin="0" Height="38" Content="☾  Dunkel" Click="DarkModeButton_Click"/>
                                    <Button x:Name="ColorModeButton" Grid.Column="4" Style="{StaticResource ChipButton}" Margin="0" Height="38" Content="◐  Farbig" Click="ColorModeButton_Click"/>
                                </Grid>
                                <Border x:Name="ColorPickerHost" Margin="0,10,0,0" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}" CornerRadius="{DynamicResource CardRadius}" Visibility="Collapsed">
                                    <local:ColorPicker x:Name="ThemeColorPicker"/>
                                </Border>
                                <TextBlock Text="Theme" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,16,0,6"/>
                                <UniformGrid x:Name="ThemeList" Columns="2"/>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="⌖" ToolTip="Immer im Vordergrund" Click="PinButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="—" ToolTip="Minimieren" Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="×" FontSize="24" ToolTip="Schließen" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="ClockPage" Grid.Row="1" Margin="24,4,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.05*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1.25*" MinWidth="380"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Main clock -->
                    <Border x:Name="ClockCard" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="36,24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="WIEN" FontFamily="{DynamicResource StencilFont}" FontSize="14" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Border CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource AccentSoft}" Padding="8,4" Margin="10,0,0,0">
                                        <TextBlock x:Name="UtcOffsetBadge" Text="UTC+02:00" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="DstText" Text="Sommerzeit" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Viewbox lets the time grow and shrink with the window (small window up to beamer). -->
                            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" Margin="0,10">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="MainTimeText" Typography.NumeralAlignment="Tabular" Text="00:00:00" FontFamily="{DynamicResource DisplayFont}" FontSize="76" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MicrosecondsText" Typography.NumeralAlignment="Tabular" Text=".000000" FontFamily="{DynamicResource DisplayFont}" FontSize="24" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" Opacity="0.7" VerticalAlignment="Bottom" Margin="8,0,0,13"/>
                                </StackPanel>
                                <TextBlock x:Name="DateText" Text="Donnerstag, 15. Oktober 2026" FontSize="18" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                            </Viewbox>

                            <Grid Grid.Row="2">
                                <Border Height="5" CornerRadius="3" Background="{DynamicResource TrackBrush}"/>
                                <Border Height="5" CornerRadius="3" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="SecondProgress" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Lesson countdown -->
                    <Border x:Name="LessonCard" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="28,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="LessonBadge" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource AccentSoft}" Padding="9,4">
                                        <TextBlock x:Name="LessonBadgeText" Text="1. STUNDE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <TextBlock x:Name="LessonRangeText" Text="07:45 – 08:35" FontFamily="{DynamicResource DisplayFont}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="LessonOfDayText" Text="" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="LessonLabelText" Text="Stunde endet in" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock x:Name="LessonNextText" Text="" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="LessonCountdownText" Typography.NumeralAlignment="Tabular" Grid.Column="1" Text="00:00" FontFamily="{DynamicResource DisplayFont}" FontSize="60" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Border Height="8" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource TrackBrush}"/>
                                <Border x:Name="LessonProgressFill" Height="8" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="LessonProgress" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right panel: today's timetable -->
                <Border x:Name="ScheduleCard" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="20,22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="STUNDENPLAN" FontFamily="{DynamicResource StencilFont}" FontSize="24"/>
                                <TextBlock x:Name="ScheduleSubtitleText" Text="11 Stunden à 50 Minuten" FontSize="13.5" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="GroupButton" Style="{StaticResource ChipButton}" Height="26" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Content="Gruppe: beide" ToolTip="Gruppe bei geteilten Fächern (E1, ITP2, INSY, SEW) wechseln" Click="GroupButton_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel x:Name="ScheduleList"/>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="{DynamicResource CardRadius}" Padding="14,10" Margin="0,12,0,0"
                                ToolTip="Die Uhr gleicht sich alle 5 Minuten mit Atomzeit-Servern (NTP) ab.">
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="SyncStatusText" Text="Wird geprüft" FontSize="12" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Abgleich " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="LastSyncText" Text="—" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,4,0,0">
                                    <TextBlock x:Name="SourceText" Text="Windows-Systemzeit" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="OffsetText" Text="± 0,000 ms" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="LatencyText" Text="— ms" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SyncButton" Style="{StaticResource ActionButton}" Content="↻  Synchronisieren" Padding="8,0" Click="SyncButton_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="0" Content="✦" FontSize="16" ToolTip="Feuerwerk testen (F9)" Click="FireworksButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <!-- Caffeine tracker -->
            <ScrollViewer x:Name="CaffeineScroll" Grid.Row="1" Margin="24,4,24,24" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid x:Name="CaffeinePage">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" MinWidth="260"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.45*" MinWidth="360"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="0.85*" MinWidth="230"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <!-- Daily summary -->
                <Border x:Name="CaffeineSummaryCard" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Heute" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TrackerDateText" Text="Donnerstag, 15. Oktober" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Width="190" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12">
                            <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="13"/>
                            <Path x:Name="CaffeineProgressArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="13" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="CaffeineTotalText" Text="0" FontFamily="{DynamicResource DisplayFont}" FontSize="46" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="mg heute" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                <Border x:Name="LimitStatusBadge" Background="{DynamicResource GreenSoft}" CornerRadius="{DynamicResource CardRadius}" Padding="9,4" Margin="0,9,0,0">
                                    <TextBlock x:Name="LimitStatusText" Text="im Rahmen" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GESCHÄTZT AKTIV" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="ActiveCaffeineText" Text="0 mg" FontFamily="{DynamicResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="BIS ZUM LIMIT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="RemainingCaffeineText" Text="400 mg" FontFamily="{DynamicResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3" Background="{DynamicResource SurfaceAlt}" CornerRadius="{DynamicResource CardRadius}" Padding="14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tageslimit" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Orientierungswert, kein Ziel" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBox x:Name="DailyLimitTextBox" Grid.Column="1" Style="{StaticResource InputTextBox}" Height="38" Text="400" TextAlignment="Center" LostFocus="DailyLimitTextBox_LostFocus" KeyDown="DailyLimitTextBox_KeyDown"/>
                                </Grid>
                                <TextBlock Text="EFSA: bis 400 mg/Tag für gesunde Erwachsene. Schwangerschaft/Stillzeit: 200 mg. Individuelle Verträglichkeit kann abweichen."
                                           TextWrapping="Wrap" FontSize="9.5" LineHeight="14" Foreground="{DynamicResource TextMuted}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Product catalog -->
                <Border x:Name="CaffeineCatalogCard" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Getränk hinzufügen" FontSize="21" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CatalogCountText" Text="Produkte aus Österreich" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Text="+1 Portion" FontSize="10" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,12">
                            <TextBox x:Name="ProductSearchTextBox" Style="{StaticResource InputTextBox}" Padding="36,0,12,0" TextChanged="ProductSearchTextBox_TextChanged"/>
                            <TextBlock Text="⌕" FontSize="20" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,1" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchHintText" Text="Marke, Produkt oder Supermarkt suchen …" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AllCategoryButton" Style="{StaticResource ChipButton}" Content="Alle" Tag="Alle" Click="CategoryButton_Click" Background="{DynamicResource AccentSoft}" Foreground="{DynamicResource AccentBrush}"/>
                            <Button x:Name="EnergyCategoryButton" Style="{StaticResource ChipButton}" Content="Energy" Tag="Energy" Click="CategoryButton_Click"/>
                            <Button x:Name="CoffeeCategoryButton" Style="{StaticResource ChipButton}" Content="Kaffee" Tag="Kaffee" Click="CategoryButton_Click"/>
                            <Button x:Name="MoreCategoryButton" Style="{StaticResource ChipButton}" Content="Mehr" Tag="Mehr" Click="CategoryButton_Click"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-6,0">
                            <ItemsControl x:Name="ProductsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="{DynamicResource CardRadius}" Margin="0,0,6,8" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Image, Mode=OneWay}" Width="48" Height="48" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Brand, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ServingLabel, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Store, Mode=OneWay}" FontSize="9" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource RoundAddButton}" Content="+" DataContext="{Binding}" Click="AddProductButton_Click" ToolTip="Jetzt eintragen"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="4" Style="{StaticResource SecondaryButton}" Height="40" Content="＋  Eigenes Getränk eintragen" Margin="0,10,0,0" Click="OpenCustomEntryButton_Click"/>
                    </Grid>
                </Border>

                <!-- Today's log -->
                <Border x:Name="CaffeineLogCard" Grid.Column="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tagesverlauf" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock x:Name="EntryCountText" Text="Noch keine Einträge" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,16,0,10">
                            <StackPanel x:Name="EmptyHistoryPanel" VerticalAlignment="Center">
                                <TextBlock Text="☕" FontSize="34" HorizontalAlignment="Center" Opacity="0.45"/>
                                <TextBlock Text="Noch nichts getrackt" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="Füge links dein erstes Getränk hinzu." FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="8,3"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="HistoryItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Image Source="{Binding Image, Mode=OneWay}" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding ProductName, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="9.5" Foreground="{DynamicResource TextMuted}"><Run Text="{Binding TimeLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DetailLabel, Mode=OneWay}"/></TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding AmountLabel, Mode=OneWay}" FontFamily="{DynamicResource DisplayFont}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        <Button Content="entfernen" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMuted}" FontSize="8.5" Padding="0" Cursor="Hand" DataContext="{Binding}" Click="DeleteEntryButton_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Border Grid.Row="2" Background="{DynamicResource AccentSoft}" CornerRadius="{DynamicResource CardRadius}" Padding="12">
                            <TextBlock x:Name="TrackerInsightText" Text="Deine Koffeinbilanz erscheint nach dem ersten Eintrag." TextWrapping="Wrap" FontSize="10" LineHeight="14" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>

            <!-- Todo list and notes, built in code like the other pages. -->
            <local:TodoPage x:Name="TodoView" Grid.Row="1" Margin="24,4,24,24" Visibility="Collapsed"/>
            <local:NotesPage x:Name="NotesView" Grid.Row="1" Margin="24,4,24,24" Visibility="Collapsed"/>
            <tutor:TutorPage x:Name="TutorView" Grid.Row="1" Margin="24,4,24,24" Visibility="Collapsed"/>

            <!-- Custom caffeine entry dialog -->
            <Grid x:Name="CustomEntryOverlay" Grid.RowSpan="2" Background="#A8000000" Visibility="Collapsed" Panel.ZIndex="100">
                <Border x:Name="CustomEntryCard" Width="430" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Eigenes Getränk" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="Für neue Sorten, Cafés und regionale Produkte" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Content="×" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseCustomEntryButton_Click"/>
                        </Grid>
                        <TextBlock Text="Marke / Hersteller" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,6"/>
                        <TextBox x:Name="CustomBrandTextBox" Style="{StaticResource InputTextBox}"/>
                        <TextBlock Text="Produktname" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,12,0,6"/>
                        <TextBox x:Name="CustomNameTextBox" Style="{StaticResource InputTextBox}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Portion in ml" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                <TextBox x:Name="CustomMlTextBox" Style="{StaticResource InputTextBox}" Text="250"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Koffein in mg" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                <TextBox x:Name="CustomMgTextBox" Style="{StaticResource InputTextBox}" Text="80"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CustomEntryErrorText" Text="" FontSize="10" Foreground="{DynamicResource OrangeBrush}" Margin="0,9,0,0"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource SecondaryButton}" Content="Abbrechen" Click="CloseCustomEntryButton_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource ActionButton}" Content="Eintragen" Click="SaveCustomEntryButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Old film projection: grain, dust, scratches, flicker and vignette over everything. -->
            <local:FilmOverlay x:Name="FilmGrain" Grid.RowSpan="2" Panel.ZIndex="200"/>
            <local:HackerScanlines x:Name="HackerScanLayer" Grid.RowSpan="2" Panel.ZIndex="200" Visibility="Collapsed"/>
            <local:AnimeOverlay x:Name="AnimeTop" Grid.RowSpan="2" Panel.ZIndex="200" Visibility="Collapsed"/>
            <local:MinecraftOverlay x:Name="MinecraftTop" Grid.RowSpan="2" Panel.ZIndex="200" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
