<Window x:Class="ViennaAtomicClock.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.about.open}"
        Width="540" Height="560" MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}"
        Icon="app.ico" TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="{DynamicResource L.about.open}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="FREEDOM" FontFamily="{DynamicResource StencilFont}" FontSize="32" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource L.about.subtitle}" Margin="0,5,0,18" FontSize="13"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                        CornerRadius="{DynamicResource CardRadius}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource L.about.version}" Foreground="{DynamicResource TextSecondary}" Margin="0,3,12,9"/>
                        <TextBlock x:Name="VersionText" Grid.Column="1" FontWeight="SemiBold" Margin="0,3,0,9"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource L.about.commit}" Foreground="{DynamicResource TextSecondary}" Margin="0,3,12,9"/>
                        <TextBlock x:Name="CommitText" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" Margin="0,3,0,9"/>
                        <TextBlock Grid.Row="2" Text="{DynamicResource L.about.built}" Foreground="{DynamicResource TextSecondary}" Margin="0,3,12,9"/>
                        <TextBlock x:Name="BuildDateText" Grid.Row="2" Grid.Column="1" Margin="0,3,0,9"/>
                        <TextBlock Grid.Row="3" Text="{DynamicResource L.about.runtime}" Foreground="{DynamicResource TextSecondary}" Margin="0,3,12,0"/>
                        <TextBlock x:Name="RuntimeText" Grid.Row="3" Grid.Column="1" Margin="0,3,0,0"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                        CornerRadius="{DynamicResource CardRadius}" Padding="18" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.about.local}" TextWrapping="Wrap" LineHeight="20"/>
                        <TextBlock Text="{DynamicResource L.about.data}" FontWeight="SemiBold" Margin="0,16,0,4"/>
                        <TextBlock x:Name="DataFolderText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Style="{StaticResource ActionButton}" Content="{DynamicResource L.close}" HorizontalAlignment="Right"
                MinWidth="130" Margin="0,18,0,0" Click="CloseButton_Click" IsDefault="True" IsCancel="True"
                AutomationProperties.Name="{DynamicResource L.close}"/>
    </Grid>
</Window>
